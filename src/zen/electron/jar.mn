# JAR manifest for Electron compatibility layer chrome resources

electron.jar:
% content electron %content/
  content/electron-window.xhtml                (content/electron-window.xhtml)
  content/electron-mode.css                    (content/electron-mode.css)

# Examples
% content electron-examples %examples/
  examples/hello-world/index.html              (examples/hello-world/index.html)
  examples/hello-world/preload.js              (examples/hello-world/preload.js)
  examples/hello-world/main.js                 (examples/hello-world/main.js)
  examples/hello-world/runner.sys.mjs          (examples/hello-world/runner.sys.mjs)
