# Build configuration for the Electron compatibility layer

DIRS += [
    "common",
    "content",
    "host",
    "main",
    "renderer",
    "actors",
    "examples",
]

# Register the main electron module
EXTRA_JS_MODULES.electron += [
    "electron.sys.mjs",
]

# Chrome content (XUL windows, etc.)
JAR_MANIFESTS += ["jar.mn"]
